<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PreferenceSpecifiers</key>
  <array>
    <dict>
      <key>Type</key>
      <string>PSGroupSpecifier</string>
      <key>Title</key>
      <string>Keychain</string>
      <key>FooterText</key>
      <string>Turn Erase on, then open ReFineID once. The app deletes every card number, pairing, and credential it keeps, and turns this switch back off. Cards will ask for their numbers again and devices will need re-pairing.</string>
    </dict>
    <dict>
      <key>Type</key>
      <string>PSToggleSwitchSpecifier</string>
      <key>Title</key>
      <string>Erase all ReFineID data</string>
      <key>Key</key>
      <string>fi.refineid.eraseKeychainRequested</string>
      <key>DefaultValue</key>
      <false/>
    </dict>
  </array>
</dict>
</plist>
